{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RecoRequestRecord",
  "description": "Schema for probe request records written to gcl.reco_requests by scripts/probe_script.py",
  "type": "object",
  "required": ["probe_id", "team", "sent_at", "payload"],
  "properties": {
    "probe_id": {
      "type": "string",
      "description": "UUID identifying the probe invocation"
    },
    "team": {
      "type": "string",
      "description": "Team identifier (e.g. 'gcl')"
    },
    "sent_at": {
      "type": "string",
      "description": "ISO-8601 timestamp when the request was sent"
    },
    "url": {
      "type": "string",
      "description": "Endpoint URL that was called"
    },
    "payload": {
      "type": "object",
      "description": "Request body forwarded to /recommend",
      "required": ["user_id"],
      "properties": {
        "user_id": {"type": "integer"},
        "n":       {"type": "integer"},
        "model":   {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
